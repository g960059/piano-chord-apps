// ピアノ和音アプリ：Cloudflare Workers（無料プラン）の設定
// - ページ（*.html・assets/ など）はリポジトリのいちばん上からそのまま公開する（ビルドなし）。
//   公開しないファイル（src/・test/・docs/・migrations/ など）は .assetsignore に書く。
// - /api/* だけ Worker（src/worker.js）。「和音の聴きわけ」のランキング。
// - D1はもとの「和音ききわけ」とおなじ waon-ranking（いままでのランキングがそのままつづく）。
// - ADMIN_KEY（先生用キー、24文字以上）は Cloudflare の画面か `npx wrangler secret put ADMIN_KEY` で入れる。ここには書かない。
//   つかいかたは docs/RANKING-ADMIN.md、うつしかえの手順は docs/MIGRATION-RANKING.md。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piano-chord-apps",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /api/* はファイルがあってもかならず Worker へ。ほかは静的ファイルを先にさがし、なければ Worker へ（404）。
    "run_worker_first": ["/api/*"],
    // いままでとおなじ（/ear.html → /ear へうつる、/ は index.html）。書かなくてもこれがきまり
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waon-ranking",
      "database_id": "43b354cf-87c0-411f-b2f0-5fd06a1efdec",
      "migrations_dir": "migrations"
    }
  ],
  // 毎日16:05 UTC（日本時間1:05）に古い run・塩・週の記録をそうじする（無料プランでつかえる）
  "triggers": { "crons": ["5 16 * * *"] },
  // console.error などのログだけのこす。1回ごとのリクエストの記録（URL・場所の情報など）はのこさない
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // ブランチの Preview（main いがいのビルド）の設定。Preview は上の設定をうけつがない。
  // わざと D1をつながない：Preview であそんでも本物のランキングにのらない（/api は501 → 画面は「オフライン」であそべる）。
  // Preview でもランキングをためしたいときは、べつの D1（例 waon-ranking-preview）をつくってここに "d1_databases" を書く。
  "previews": {}
}
